# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-5-nano

# LLM provider routing
# Supported: openai | vertexai
# Master safety toggle (set false to force-disable Vertex AI paths)
ENABLE_VERTEXAI=true
LLM_PROVIDER=openai
# Optional fallback provider for controlled rollout
FALLBACK_LLM_PROVIDER=
# Optional explicit model overrides
LLM_MODEL=
FALLBACK_LLM_MODEL=

# Vertex AI configuration (required when LLM_PROVIDER=vertexai)
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash-001
VERTEX_EMBEDDING_MODEL=text-embedding-005

# Embedding provider override for retrieval/ingestion.
# Defaults to LLM_PROVIDER when unset.
EMBEDDING_PROVIDER=

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here  # Optional, for authenticated Qdrant instances
QDRANT_COLLECTION_NAME=my_rag_collection  # Optional, defaults to "my_rag_collection"

# Google Drive API Configuration (for RAG ingestion)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/your-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Optional: Campaigns folder name within the Drive folder
CAMPAIGNS_FOLDER_NAME=Campaigns

# LangSmith tracing (LangGraph / LangChain runs)
# 1) Sign in at https://smith.langchain.com
# 2) Create a Project (e.g. brief-tutor) — traces are grouped by project name
# 3) Settings → API keys → create a key and paste it below
# Use the literal string "true" for LANGSMITH_TRACING (not True).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=brief-tutor
# Optional: custom/self-hosted endpoint only
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Until LANGSMITH_API_KEY is a real key, LangSmith may return HTTP 403 on ingest; set LANGSMITH_TRACING=false to disable tracing locally.

# Optional: append each successful workflow run to a LangSmith dataset (same compact I/O as the trace).
# Create a dataset in the UI with type **Key-value**. You do not need an ID if the name is unique:
# LANGSMITH_DATASET_NAME=campaign-brief-io
# Or use the dataset UUID (from the dataset URL or settings) if you prefer:
# LANGSMITH_DATASET_ID=00000000-0000-0000-0000-000000000000
# Optional split label for the example row:
# LANGSMITH_DATASET_SPLIT=train

# Optional: parse spreadsheets through MCP sampling instead of direct pandas.
# Uses excel-mcp-server (https://github.com/negokaz/excel-mcp-server) and reads
# only targeted ranges that are needed by this workflow.
# Custom in-repo MCP parser (recommended first MCP path):
# CUSTOM_BRIEF_MCP_ENABLED=true
# Optional override for custom MCP server launch command:
# CUSTOM_BRIEF_MCP_COMMAND=python -m graph.mcp_utils.server
#
# Existing external Excel MCP parser:
# Set to true to enable MCP sampling path:
# EXCEL_MCP_ENABLED=true
# Optional override for the MCP server command:
# EXCEL_MCP_COMMAND=cmd /c npx --yes @negokaz/excel-mcp-server

# Lightweight evaluation gates for groundedness + schema completeness
EVAL_MIN_GROUNDEDNESS=0.8
EVAL_MIN_FIELD_COMPLETENESS=1.0

# Optional observability/alerts
ALERT_MAX_NODE_LATENCY_MS=45000
WORKFLOW_METRICS_FILE=workflow_metrics.jsonl
# Console: analytics (eval_metrics, node_metrics, diagnosis breakdowns) default off
# WORKFLOW_CONSOLE_ANALYTICS=false
# WORKFLOW_VERBOSE_CONSOLE=false
# Optional: overwrite this JSON file after each run with eval + per-node provider/latency (for dashboards / other metrics tools).
# WORKFLOW_METRICS_REPORT_FILE=reports/workflow_metrics_report.json
